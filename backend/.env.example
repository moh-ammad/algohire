DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/algohire?schema=public"
# Local Docker tip: postgres-18 uses POSTGRES_PASSWORD from `docker inspect`
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-production"
PORT=3000

# Optional — Gemini free tier (officer brief + spreadsheet error help)
# Get a key: https://aistudio.google.com/apikey
# Never commit the real key. Do not reuse keys from random temp files.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
